+        E.noParams
+        (D.singleRow (D.column (D.nonNullable D.jsonb)))
+    snapshot <- either (fail . show) pure result
+    Lazy.hPutStrLn stderr (Aeson.encode (Aeson.object ["maintenance" Aeson..= label, "snapshot" Aeson..= (snapshot :: Aeson.Value)]))
