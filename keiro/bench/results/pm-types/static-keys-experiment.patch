+-- Direct encoding avoids building an intermediate JSON tree on polling reads.
+-- Keep its meaning equal to processManagerTypeJson (covered by parity tests).
+instance Aeson.ToJSON ProcessManagerTypeSummary where
+  toJSON = processManagerTypeJson
+  toEncoding summary =
+    Encoding.pairs
+      ( encodedField "\"category\"" (Aeson.toEncoding summary.category)
+          <> encodedField "\"name\"" (Aeson.toEncoding summary.name)
+          <> encodedField "\"snapshot_policy\"" (Aeson.toEncoding summary.snapshotPolicy)
+          <> encodedField "\"snapshots_configured\"" (Aeson.toEncoding summary.snapshotsConfigured)
+          <> encodedField "\"timers_configured\"" (Aeson.toEncoding summary.timersConfigured)
+      )
+
+-- Fixed, quoted JSON field names; every value still uses Aeson's escaping.
+-- This shares code literals, without retaining descriptor or response data.
+encodedField :: ByteString -> Encoding.Encoding -> Encoding.Series
+encodedField key = Encoding.pair' (Encoding.unsafeToEncoding (Builder.byteString key))
+
 data DispatchWitness = EventPresent | NotObserved deriving stock (Generic, Eq, Show)
 
