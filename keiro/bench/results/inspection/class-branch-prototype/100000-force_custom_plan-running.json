EN status='running' THEN 'retrying' WHEN status='suspended' AND wake_after IS NOT NULL THEN 'sleeping' WHEN status='suspended' THEN 'awaiting' ELSE status END)='completed' ORDER BY workflow_name,workflow_id LIMIT $2) UNION ALL (SELECT workflow_id,workflow_name,generation,status,attempts,last_error,next_attempt_at,wake_after,leased_by,lease_expires_at,created_at,updated_at,completed_at FROM keiro.keiro_workflows WHERE ($1 & 32)<>0 AND (CASE WHEN status='running' AND attempts=0 THEN 'running' WHEN status='running' THEN 'retrying' WHEN status='suspended' AND wake_after IS NOT NULL THEN 'sleeping' WHEN status='suspended' THEN 'awaiting' ELSE status END)='cancelled' ORDER BY workflow_name,workflow_id LIMIT $2) UNION ALL (SELECT workflow_id,workflow_name,generation,status,attempts,last_error,next_attempt_at,wake_after,leased_by,lease_expires_at,created_at,updated_at,completed_at FROM keiro.keiro_workflows WHERE ($1 & 64)<>0 AND (CASE WHEN status='running' AND attempts=0 THEN 'running' WHEN status='running' THEN 'retrying' WHEN status='suspended' AND wake_after IS NOT NULL THEN 'sleeping' WHEN status='suspended' THEN 'awaiting' ELSE status END)='failed' ORDER BY workflow_name,workflow_id LIMIT $2)) AS candidates ORDER BY workflow_name,workflow_id LIMIT $2) SELECT now(),inspection_page.* FROM (VALUES(1)) AS clock(x) LEFT JOIN inspection_page ON true ORDER BY workflow_name,workflow_id"}