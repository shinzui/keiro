'failed' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4)) AS candidates ORDER BY workflow_name, workflow_id LIMIT $4) SELECT now(), inspection_page.* FROM (VALUES (1)) AS clock(x) LEFT JOIN inspection_page ON true ORDER BY workflow_name, workflow_id"}