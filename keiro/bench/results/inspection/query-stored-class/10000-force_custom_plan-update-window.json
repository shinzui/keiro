ows WHERE ($1::int4 & 16) <> 0 AND inspection_status_class = 'completed' AND updated_at >= $2 ORDER BY workflow_name, workflow_id LIMIT $3) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 32) <> 0 AND inspection_status_class = 'cancelled' AND updated_at >= $2 ORDER BY workflow_name, workflow_id LIMIT $3) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 64) <> 0 AND inspection_status_class = 'failed' AND updated_at >= $2 ORDER BY workflow_name, workflow_id LIMIT $3)) AS candidates ORDER BY workflow_name, workflow_id LIMIT $3) SELECT now(), inspection_page.* FROM (VALUES (1)) AS clock(x) LEFT JOIN inspection_page ON true ORDER BY workflow_name, workflow_id"}