s = 'retrying' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 4) <> 0 AND inspection_status_class = 'sleeping' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 8) <> 0 AND inspection_status_class = 'awaiting' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 16) <> 0 AND inspection_status_class = 'completed' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 32) <> 0 AND inspection_status_class = 'cancelled' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE ($1::int4 & 64) <> 0 AND inspection_status_class = 'failed' AND (workflow_name, workflow_id) > ($2,$3) ORDER BY workflow_name, workflow_id LIMIT $4)) AS candidates ORDER BY workflow_name, workflow_id LIMIT $4) SELECT now(), inspection_page.* FROM (VALUES (1)) AS clock(x) LEFT JOIN inspection_page ON true ORDER BY workflow_name, workflow_id"}