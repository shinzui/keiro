_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE 'cancelled' = ANY($1::text[]) AND status = 'cancelled' AND (octet_length(workflow_name) + octet_length(workflow_id)) > 2600 LIMIT 65) UNION ALL (SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE 'failed' = ANY($1::text[]) AND status = 'failed' AND (octet_length(workflow_name) + octet_length(workflow_id)) > 2600 LIMIT 65)) AS wide_candidates LIMIT 65), wide_budget AS MATERIALIZED (SELECT count(*) > 64 OR coalesce(sum((octet_length(workflow_name) + octet_length(workflow_id))),0) > 262144 AS exceeded FROM inspection_wide), inspection_page AS MATERIALIZED (SELECT * FROM ((SELECT workflow_id, workflow_name, generation, status, attempts, last_error, next_attempt_at, wake_after, leased_by, lease_expires_at, created_at, updated_at, completed_at FROM keiro.keiro_workflows WHERE (octet_length(workflow_name) + octet_length(workflow_id)) <= 2600 AND (created_at, workflow_name, workflow_id) < ($2,$3,$4) ORDER BY created_at DESC, workflow_name DESC, workflow_id DESC LIMIT $5) UNION ALL SELECT * FROM inspection_wide WHERE (created_at, workflow_name, workflow_id) < ($2,$3,$4)) AS candidates WHERE NOT (SELECT exceeded FROM wide_budget) ORDER BY created_at DESC, workflow_name DESC, workflow_id DESC LIMIT $5) SELECT now(), (SELECT exceeded FROM wide_budget), inspection_page.* FROM (VALUES (1)) AS clock(x) LEFT JOIN inspection_page ON true ORDER BY created_at DESC, workflow_name DESC, workflow_id DESC","wide_fixture":false}