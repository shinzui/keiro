language keiro-dsl 4
context nominal-errors

mapped nominal AccountNumber : Text {
  haskell package=domain module=Domain.Account type=AccountNumber
  binding = "Domain.Bindings.accountNumberBinding"
  binding-version = "1"
  canonical-type = "domain.AccountNumber.v1"
  fixtures = "Domain.Bindings.accountNumberFixtures"
}

aggregate Ledger
  regs accountNumber AccountNumber = initial
  states Empty
  command Touch { }
  event Touched = fields(Touch)
  Empty -- Touch --> emit Touched ; goto Empty
  wire kind=ctorName fields=camelCase schemaVersion=1
