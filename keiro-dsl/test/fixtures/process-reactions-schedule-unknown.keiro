language keiro-dsl 6
context reaction-negative
id ItemId prefix=item
process P
  name "p"
  reactions version 1
  input A { itemId:ItemId at:Time }
  correlate input.itemId via idText
  saga Saga category "saga"
  target Target
  projections [ ]
  on A
    schedule missing fireAt input.at + 5m { itemId }
  dispatch-id strategy=uuidv5 from=(name, correlationId, sourceEventId, targetStreamName, occurrence)
  rejected => halt
  poison => halt
aggregate Saga
  regs
  states Open
  command KeepSaga { itemId }
  event SagaKept = fields(KeepSaga)
  Open -- KeepSaga --> emit SagaKept ; goto Open
aggregate Target
  regs
  states Open
  command KeepTarget { itemId }
  event TargetKept = fields(KeepTarget)
  Open -- KeepTarget --> emit TargetKept ; goto Open
