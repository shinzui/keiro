context demo-project

id RunId prefix=run

aggregate Run
  regs
    runId RunId = placeholder
    state RunVertex = Pending
  states Pending Done!

  command DoThing { runId attempt:Int }
  event ThingCompleted { runId attempt:Int }

  Pending -- DoThing -->
    write state := Done
    emit ThingCompleted
    goto Done

  wire kind=ctorName fields=camelCase schemaVersion=1
