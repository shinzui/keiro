language keiro-dsl 4
context demo-project

id RUnId prefix=runb

aggregate RUn
  regs
    rUnId RUnId = placeholder
  states Pending Done!

  command Redo { rUnId attempt:Int }
  event Redone { rUnId attempt:Int }

  Pending -- Redo -->
    emit Redone
    goto Done

  wire kind=ctorName fields=camelCase schemaVersion=1
