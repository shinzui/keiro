language keiro-dsl 1
context mapped-illtyped-default

mapped structural record Thing {
  haskell package=example-domain module=Example.Domain type=Thing
  binding = "Example.Bindings.thingBinding"
  binding-version = "1"
  canonical-type = "example.Thing.v1"
  fixtures = "Example.Bindings.thingCases"
  wire object constructor=Thing unknown-fields=reject {
    value as "value" : Text optional on-missing=0
  }
}
