language keiro-dsl 1
context aggregate-scalar-expressions-v1

aggregate ScalarAccount
  regs
    balance Integer = 0
  states Open Closed!
  command Adjust { balance:Integer }
  event Adjusted = fields(Adjust)
  Open -- Adjust -->
    guard cmd.balance + reg.balance >= 0
    write balance := reg.balance + cmd.balance
    emit Adjusted
    goto Closed
