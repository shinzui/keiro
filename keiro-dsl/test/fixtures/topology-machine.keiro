language keiro-dsl 6
context topology-machine

id OrderId prefix=ord

# Order covers: three or more states, two edges leaving Draft separated by an
# edge leaving Open, a replay-only edge, a two-event edge, a terminal state
# and a hole-owned transition body.
aggregate Order
  regs
  states Draft Open InTransit Done!

  command PlaceOrder { orderId }
  command AmendOrder { orderId }
  command NoteOrder { orderId note:Text }
  command ShipOrder { orderId }
  command CloseOrder { orderId }

  event OrderPlaced = fields(PlaceOrder)
  event OrderAmended = fields(AmendOrder)
  event OrderNoted = fields(NoteOrder)
  event OrderShipped = fields(ShipOrder)
  event ShipmentLabelled = fields(ShipOrder)
  event OrderClosed = fields(CloseOrder)

  Draft -- PlaceOrder --> emit OrderPlaced ; goto Open
  Open -- AmendOrder --> emit OrderAmended ; goto Open
  Draft -- NoteOrder -->
    implementation hole
    emit OrderNoted
    goto Draft
  Open -- ShipOrder --> emit OrderShipped ; emit ShipmentLabelled ; goto InTransit
  replay-only Open -- CloseOrder --> emit OrderClosed ; goto Done
  InTransit -- CloseOrder --> emit OrderClosed ; goto Done

  wire kind=ctorName fields=camelCase schemaVersion=1

# OrderSaga is the process manager's own state.
aggregate OrderSaga
  regs
  states Waiting Requested

  command RecordRequest { orderId }
  command FinishRequest { orderId }

  event RequestRecorded = fields(RecordRequest)
  event RequestFinished = fields(FinishRequest)

  Waiting -- RecordRequest --> emit RequestRecorded ; goto Requested
  Requested -- FinishRequest --> emit RequestFinished ; goto Waiting
  Requested -- RecordRequest --> emit RequestRecorded ; goto Requested

  wire kind=ctorName fields=camelCase schemaVersion=1

process OrderFlow
  name "order-flow"
  reactions version 1
  input OrderRequested { orderId:OrderId }
  correlate input.orderId via idText
  saga OrderSaga category "orderSaga"
  target Order
  projections [ ]
  on OrderRequested
    advance RecordRequest { orderId }
      accepted
        dispatch Order@input.orderId PlaceOrder { orderId }
          on-appended AckOk ; on-duplicate AckOk ; on-failed Retry
      silent no-action
  dispatch-id strategy=uuidv5 from=(name, correlationId, sourceEventId, targetStreamName, occurrence)
  rejected => halt
  poison => halt
