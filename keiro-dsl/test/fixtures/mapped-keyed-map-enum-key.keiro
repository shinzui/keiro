language keiro-dsl 6
context keyed-map-enum-key

enum Channel { Email=email Sms=sms }

mapped structural record TemplateBook {
  haskell package=keiro-dsl module=KeyedMapEnumKey.Domain type=TemplateBook
  binding = "KeyedMapEnumKey.Bindings.templateBookBinding"
  binding-version = "1"
  canonical-type = "keyed-map-enum-key.TemplateBook.v1"
  fixtures = "KeyedMapEnumKey.Bindings.templateBookFixtures"
  wire object constructor=TemplateBook unknown-fields=reject {
    byChannel as "by_channel" : Map[Channel] Text required
  }
}
