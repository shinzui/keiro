language keiro-dsl 6
context process-reactions

id IncidentId prefix=inc
enum Severity { Sev1=sev1 Sev2=sev2 }

process IncidentReaction
  name "incident-reaction"
  reactions version 1
  input IncidentReported { incidentId:IncidentId severity:Severity }
  input IncidentNoted { incidentId:IncidentId }
  correlate input.incidentId via idText
  saga IncidentSaga category "incidentSaga"
  target Incident
  projections [ ]

  on IncidentReported
    when input.severity == Severity.Sev1
      advance RecordCritical { incidentId }
      dispatch Incident@input.incidentId EscalateIncident { incidentId }
        on-appended AckOk ; on-duplicate AckOk ; on-failed Retry
    otherwise
      advance RecordRoutine { incidentId }

  on IncidentNoted
    no-action

  dispatch-id strategy=uuidv5 from=(name, correlationId, sourceEventId, targetStreamName, occurrence)
  rejected => halt
  poison => halt

process AuditOnly
  name "audit-only"
  reactions version 1
  input IncidentNoted { incidentId:IncidentId }
  correlate input.incidentId via idText
  saga IncidentSaga category "incidentAudit"
  target Incident
  projections [ ]
  on IncidentNoted
    no-action
  dispatch-id strategy=uuidv5 from=(name, correlationId, sourceEventId, targetStreamName, occurrence)
  rejected => halt
  poison => halt

process ScalingReaction
  name "scaling-reaction"
  reactions version 1
  input FanOut8Same { incidentId:IncidentId }
  input FanOut32Same { incidentId:IncidentId }
  input FanOut128Same { incidentId:IncidentId }
  input FanOut8Distinct { incidentId:IncidentId target001:IncidentId target002:IncidentId target003:IncidentId target004:IncidentId target005:IncidentId target006:IncidentId target007:IncidentId target008:IncidentId }
  input FanOut32Distinct { incidentId:IncidentId target001:IncidentId target002:IncidentId target003:IncidentId target004:IncidentId target005:IncidentId target006:IncidentId target007:IncidentId target008:IncidentId target009:IncidentId target010:IncidentId target011:IncidentId target012:IncidentId target013:IncidentId target014:IncidentId target015:IncidentId target016:IncidentId target017:IncidentId target018:IncidentId target019:IncidentId target020:IncidentId target021:IncidentId target022:IncidentId target023:IncidentId target024:IncidentId target025:IncidentId target026:IncidentId target027:IncidentId target028:IncidentId target029:IncidentId target030:IncidentId target031:IncidentId target032:IncidentId }
  input FanOut128Distinct { incidentId:IncidentId target001:IncidentId target002:IncidentId target003:IncidentId target004:IncidentId target005:IncidentId target006:IncidentId target007:IncidentId target008:IncidentId target009:IncidentId target010:IncidentId target011:IncidentId target012:IncidentId target013:IncidentId target014:IncidentId target015:IncidentId target016:IncidentId target017:IncidentId target018:IncidentId target019:IncidentId target020:IncidentId target021:IncidentId target022:IncidentId target023:IncidentId target024:IncidentId target025:IncidentId target026:IncidentId target027:IncidentId target028:IncidentId target029:IncidentId target030:IncidentId target031:IncidentId target032:IncidentId target033:IncidentId target034:IncidentId target035:IncidentId target036:IncidentId target037:IncidentId target038:IncidentId target039:IncidentId target040:IncidentId target041:IncidentId target042:IncidentId target043:IncidentId target044:IncidentId target045:IncidentId target046:IncidentId target047:IncidentId target048:IncidentId target049:IncidentId target050:IncidentId target051:IncidentId target052:IncidentId target053:IncidentId target054:IncidentId target055:IncidentId target056:IncidentId target057:IncidentId target058:IncidentId target059:IncidentId target060:IncidentId target061:IncidentId target062:IncidentId target063:IncidentId target064:IncidentId target065:IncidentId target066:IncidentId target067:IncidentId target068:IncidentId target069:IncidentId target070:IncidentId target071:IncidentId target072:IncidentId target073:IncidentId target074:IncidentId target075:IncidentId target076:IncidentId target077:IncidentId target078:IncidentId target079:IncidentId target080:IncidentId target081:IncidentId target082:IncidentId target083:IncidentId target084:IncidentId target085:IncidentId target086:IncidentId target087:IncidentId target088:IncidentId target089:IncidentId target090:IncidentId target091:IncidentId target092:IncidentId target093:Incident