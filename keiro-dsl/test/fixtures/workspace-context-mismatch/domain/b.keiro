language keiro-dsl 4
context beta

id BetaId prefix=bet

aggregate Beta
  regs
    betaId BetaId = placeholder
  states Pending Done!

  command DoThing { betaId attempt:Int }
  event ThingCompleted { betaId attempt:Int }

  Pending -- DoThing -->
    emit ThingCompleted
    goto Done

  wire kind=ctorName fields=camelCase schemaVersion=1
