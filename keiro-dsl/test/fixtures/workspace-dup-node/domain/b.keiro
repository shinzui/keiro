context demo-project

id ProjectId prefix=proj2

aggregate Project
  regs
    projectId ProjectId = placeholder
    state ProjectVertex = Pending
  states Pending Done!

  command Redo { projectId attempt:Int }
  event Redone { projectId attempt:Int }

  Pending -- Redo -->
    write state := Done
    emit Redone
    goto Done

  wire kind=ctorName fields=camelCase schemaVersion=1
