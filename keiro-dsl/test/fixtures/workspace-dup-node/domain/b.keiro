context demo-project

id ProjectRefId prefix=proj2

aggregate Project
  regs
    projectRefId ProjectRefId  = placeholder
    state        ProjectVertex = Pending
  states Pending Done!

  command Redo   { projectRefId attempt:Int }
  event   Redone { projectRefId attempt:Int }

  Pending -- Redo -->
    write state := Done
    emit  Redone
    goto  Done

  wire kind=ctorName fields=camelCase schemaVersion=1
