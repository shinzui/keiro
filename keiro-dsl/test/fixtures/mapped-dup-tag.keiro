language keiro-dsl 4
context mapped-dup-tag

mapped structural union Choice {
  haskell package=example-domain module=Example.Domain type=Choice
  binding = "Example.Bindings.choiceBinding"
  binding-version = "1"
  canonical-type = "example.Choice.v1"
  fixtures = "Example.Bindings.choiceCases"
  wire tagged-object tag="tag" contents="contents" unknown-fields=reject {
    One as "same" : Text
    Two as "same" : Text
  }
}
