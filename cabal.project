packages:
  keiro
  keiro-core
  keiro-migrations
  keiro-pgmq
  keiro-test-support
  jitsurei
  keiro-dsl
  keiro-ops
  keiro-dsl/tools/corpus-regen
  keiro-dsl/test
  keiro-dsl/test/conformance-behavior-complete
  keiro-dsl/test/conformance-service-package/runtime
  keiro-dsl/test/conformance-service-package/runtime/src/keiro-dsl-conformance.workspace.workspace-proof

-- The -Werror gate on committed generated output (keiro-dsl.cabal, common
-- stanza generated-output) is flag-guarded because Hackage rejects an
-- unconditional -Werror; keep it on for every build of this repository.
package keiro-dsl
  flags: +werror-generated

source-repository-package
  type: git
  location: https://github.com/mzabani/codd.git
  tag: v0.1.8

-- pgmq-migration 0.6.1.0 caps these at 1.1; their 1.2 releases make no API or
-- behavior changes. Kiroku's migration component requires the 1.2 family.
allow-newer:
  haxl:time,
  pgmq-migration:pg-migrate,
  pgmq-migration:pg-migrate-embed,
  pgmq-migration:pg-migrate-import-hasql-migration
