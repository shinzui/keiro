packages:
  keiro
  keiro-core
  keiro-migrations
  keiro-pgmq
  keiro-test-support
  jitsurei
  keiro-dsl
  keiro-ops
  keiro-dsl/tools/corpus-regen
  keiro-dsl/test
  keiro-dsl/test/conformance-behavior-complete
  keiro-dsl/test/conformance-service-package/runtime
  keiro-dsl/test/conformance-service-package/runtime/src/keiro-dsl-conformance.workspace.workspace-proof

-- The -Werror gate on committed generated output (keiro-dsl.cabal, common
-- stanza generated-output) is flag-guarded because Hackage rejects an
-- unconditional -Werror; keep it on for every build of this repository.
package keiro-dsl
  flags: +werror-generated

-- Keiki 0.9.0.0 and keiki-codec-json 0.9.0.0 are published on Hackage
-- (2026-08-05). The pins point at the exact commit behind the v0.9.0.0 tag and
-- stay until this repository moves its index-state past the publish, at which
-- point they can be dropped.
source-repository-package
  type: git
  location: https://github.com/shinzui/keiki.git
  tag: 9714d37033c37595e3aaa3319ca0ca77466782e0

source-repository-package
  type: git
  location: https://github.com/shinzui/keiki.git
  tag: 9714d37033c37595e3aaa3319ca0ca77466782e0
  subdir: keiki-codec-json

source-repository-package
  type: git
  location: https://github.com/mzabani/codd.git
  tag: v0.1.8

allow-newer:
  haxl:time
