              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "edgeIndex",
              "target",
              "mode",
              "command",
              "events"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/name"
              },
              "edgeIndex": {
                "type": "integer",
                "minimum": 0
              },
              "target": {
                "$ref": "#/$defs/name"
              },
              "mode": {
                "enum": [
                  "Live",
                  "ReplayOnly"
                ]
              },
              "command": {
                "$ref": "#/$defs/name"
              },
              "events": {
                "$ref": "#/$defs/names"
              }
            }
          }
        }
      }
    }
  }
